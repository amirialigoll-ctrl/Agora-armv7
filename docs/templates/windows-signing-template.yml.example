name: Windows Build and Sign Template

on:
  push:
    branches: [ master ]
  pull_request:
    branches: [ master ]

jobs:
  build:
    runs-on: windows-latest

    steps:
    - uses: actions/checkout@v4

    - name: Build Application
      run: |
        # Add your build commands here
        # For example:
        # dotnet build --configuration Release
        # or
        # cmake --build build --config Release
        echo "Building..." > my-app.exe

    - name: Import Windows Certificate
      shell: pwsh
      run: |
        $cert_base64 = "${{ secrets.WINDOWS_SIGNING_CERTIFICATE_BASE64 }}"
        if (-not $cert_base64) {
          Write-Error "WINDOWS_SIGNING_CERTIFICATE_BASE64 secret is missing"
          exit 1
        }
        $cert_bytes = [System.Convert]::FromBase64String($cert_base64)
        [System.IO.File]::WriteAllBytes("certificate.pfx", $cert_bytes)

    - name: Sign Executable
      shell: pwsh
      run: |
        # Find signtool.exe or use the one in PATH
        $signtool = "C:\Program Files (x86)\Windows Kits\10\bin\10.0.19041.0\x64\signtool.exe"
        if (-not (Test-Path $signtool)) {
          $signtool = "signtool.exe" # Fallback to PATH
        }
        
        & $signtool sign /f certificate.pfx /p "${{ secrets.WINDOWS_SIGNING_CERTIFICATE_PASSWORD }}" /td sha256 /fd sha256 my-app.exe

    - name: Verify Signature
      shell: pwsh
      run: |
        $signtool = "C:\Program Files (x86)\Windows Kits\10\bin\10.0.19041.0\x64\signtool.exe"
        if (-not (Test-Path $signtool)) {
          $signtool = "signtool.exe"
        }
        
        & $signtool verify /pa my-app.exe

    - name: Cleanup Certificate
      if: always()
      shell: pwsh
      run: |
        if (Test-Path "certificate.pfx") {
          Remove-Item -Path "certificate.pfx" -Force
        }

    - name: Upload Artifact
      uses: actions/upload-artifact@v4
      with:
        name: signed-executable
        path: my-app.exe
